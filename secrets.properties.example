# Copy this file to secrets.properties (or add these keys to local.properties).
# Never commit secrets.properties or local.properties to version control.

# Google Maps SDK for Android API key (restrict by Android package name & SHA-1 in Google Cloud Console)
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Optional Android release signing configuration
# KEYSTORE_FILE=path/to/release-keystore.jks
# KEYSTORE_PASSWORD=your_store_password
# KEY_ALIAS=your_key_alias
# KEY_PASSWORD=your_key_password
